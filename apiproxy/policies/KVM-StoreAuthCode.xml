<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<KeyValueMapOperations name="KVM-StoreAuthCode" mapIdentifier="oauth2-codes">
    <DisplayName>Store Authorization Code</DisplayName>
    <Scope>environment</Scope>
    <ExpiryTimeInSecs>600</ExpiryTimeInSecs>
    <Put>
        <Key>
            <Parameter ref="authorization_code"/>
        </Key>
        <Value ref="auth_code_data"/>
    </Put>
</KeyValueMapOperations>
